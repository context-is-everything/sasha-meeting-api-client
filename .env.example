# Required
SASHA_URL=http://localhost:3005    # Your Sasha Studio URL
API_KEY=sk_your_api_key_here       # API key from My Account > API Tokens

# Optional - for remote Sasha instances
CALLBACK_PORT=4000                 # Local port for receiving events (default: 4000)
CALLBACK_URL=                      # Override callback URL (e.g., https://your-name.ngrok-free.app/events)
                                   # Leave empty for local development (auto-uses http://localhost:4000/events)
SIGNING_SECRET=                    # Your signing secret (shown once when creating API key)
                                   # Used to verify HMAC signatures on incoming callbacks
